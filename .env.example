# Copy this file to .env and replace placeholder values locally.
# Never commit the resulting .env file.
APP_NAME=RemoteSignLab Server
APP_VERSION=0.1.0
SIGNATURE_DEVICE_UID=ESP32-001

DATABASE_URL=postgresql+psycopg://remotesign_lab:change-me@localhost:5432/remotesign_lab

# Use a long, randomly generated value outside development.
ADMIN_API_KEY=change-me-with-a-long-random-value

SOFTHSM_MODULE=/usr/lib/softhsm/libsofthsm2.so
SOFTHSM_TOKEN_LABEL=REMOTESIGN-LAB
SOFTHSM_KEY_LABEL=REMOTE-SIGNING-KEY
SOFTHSM_KEY_ID=01
SOFTHSM_USER_PIN=change-me

# Public X.509 material dedicated to document signing (never the TLS cert).
PADES_SIGNING_CERTIFICATE=certs/remotesign-lab-signing.crt
PADES_CERTIFICATE_CHAIN=certs/remotesign-lab-test-ca.crt
PADES_PROFILE=PAdES-B-B

# Required only when PADES_PROFILE=PAdES-B-T. This must be a genuine
# RFC 3161 endpoint and a public trust anchor dedicated to its TSA.
TSA_URL=http://127.0.0.1:8090
TSA_CA_CERTIFICATE=certs/remotesign-lab-development-tsa-ca.crt
TSA_TIMEOUT_SECONDS=5
