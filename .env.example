# Copy this file to .env and replace placeholder values locally.
# Never commit the resulting .env file.
APP_NAME=Stage HSM Server
APP_VERSION=0.1.0
SIGNATURE_DEVICE_UID=ESP32-001

DATABASE_URL=postgresql+psycopg://stage_hsm:change-me@localhost:5432/stage_hsm

# Use a long, randomly generated value outside development.
ADMIN_API_KEY=change-me-with-a-long-random-value

SOFTHSM_MODULE=/usr/lib/softhsm/libsofthsm2.so
SOFTHSM_TOKEN_LABEL=STAGE-HSM
SOFTHSM_KEY_LABEL=REMOTE-SIGNING-KEY
SOFTHSM_KEY_ID=01
SOFTHSM_USER_PIN=change-me
